# Staging runtime variables — set as Dokploy runtime variables on the STAGING
# application (see deployment/project.staging.yaml), never committed with real
# values. Distinct from production's .env.example: every value below must
# point at the staging Odoo stack (varsco_odoo_staging), never production.

# Public variables (exposed to browser client bundle)
# Base URL for the Odoo API requests — the staging Odoo Dokploy app's domain.
VITE_ODOO_BASE_URL=https://staging-erp.varsco.com

# Public site origin, used for sitemap.xml generation
VITE_SITE_URL=https://staging.varsco.com

# Private variables (kept strictly server-side, never exposed to client)
# Secure server-to-server token for submitting leads and forms — must match
# the write_token configured on the STAGING Odoo instance's Settings UI
# (Settings → Varsco Content API), not the production token.
ODOO_WRITE_TOKEN=your_staging_write_token_here

# Comma-separated list of allowed CORS origins for server API routes
ALLOWED_ORIGINS=https://staging.varsco.com

# Currently unused (no route reads this) — kept in case a local session-signing layer
# is added later. Safe to omit from Dokploy runtime variables today.
SESSION_SECRET=your_session_encryption_secret_here
