# Public variables (exposed to browser client bundle)
# Base URL for the Odoo API requests. In production, this can point to a subdomain (e.g. https://erp.aquabloom.com)
VITE_ODOO_BASE_URL=http://localhost:8069

# Public site origin, used for sitemap.xml generation
VITE_SITE_URL=https://varsco.com

# Google Tag Manager container. Left blank on purpose: with no value the tag is
# never injected, so dev and staging stay out of production analytics by
# default rather than by remembering to switch something off.
#
# VITE_ variables are inlined at BUILD time, not read at runtime — this must be
# set as a build argument in Dokploy. Supplying it only as a runtime env var
# silently produces a bundle with no container id and no error.
VITE_GTM_ID=

# Private variables (kept strictly server-side, never exposed to client)
# Secure server-to-server token for submitting leads and forms (matches varsco_content_api.write_token)
ODOO_WRITE_TOKEN=your_secure_server_to_server_write_token_here

# Comma-separated list of allowed CORS origins for server API routes
ALLOWED_ORIGINS=https://varsco.com

# Currently unused (no route reads this) — kept in case a local session-signing layer
# is added later. Safe to omit from Dokploy runtime variables today.
SESSION_SECRET=your_session_encryption_secret_here
